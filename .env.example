# Copy this file to .env and adjust for the target machine.

# ===== 用户 / 权限 =====
# Linux: set to the owner UID/GID of the vault directory (run `stat -c %u:%g vaults`).
# Windows/macOS Docker Desktop: 1000 is normally fine.
PUID=1000
PGID=1000

# ===== 端口 / 绑定地址 =====
# Web UI. 127.0.0.1 = local only. Use 0.0.0.0 for LAN access (no auth built in).
IGNIS_BIND=127.0.0.1
IGNIS_PORT=8080
# MCP. Keep 127.0.0.1 unless the client runs on another machine.
# If exposed, put it behind a TLS reverse proxy / SSH tunnel / Tailscale.
MCP_BIND=127.0.0.1
MCP_PORT=8811

# ===== MCP 鉴权 =====
# supergateway requires this key on every MCP request (X-API-Key or
# Authorization: Bearer). Generate with: openssl rand -hex 32
# Leave empty and compose refuses to start, to avoid accidental unauthenticated exposure.
MCP_API_KEY=

# ===== 路径（相对 compose 文件所在目录）=====
# Ignis sees the whole vault root; MCP sees one vault inside it.
VAULT_ROOT=./vaults
VAULT_DIR=./vaults/test
# Vault id used by MCP tools (tools call this id as `vault`).
VAULT_ID=notes
DATA_DIR=./data
# Polling watcher patch. Required on Docker Desktop, harmless on Linux.
WATCHER_PATCH=./patches/server-core-watcher.js

# ===== 代理（不需要就留空）=====
# Example: http://host.docker.internal:10808
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal

# ===== 固定版本（建议不要随意改）=====
# ignis pinned by digest. Label: Obsidian 1.14.4.
IGNIS_IMAGE=nobbe/ignis@sha256:8faba2774dd9069360aedbf9ace87cdf926c454ccee56a2d7bc5ff7556737567
# Node base image for supergateway / obsidian-mcp.
NODE_IMAGE=node:22.23.4-bookworm-slim
# npm packages pinned exactly; npx still downloads them on a fresh cache.
SUPERGATEWAY_VERSION=4.2.1
OBSIDIAN_MCP_VERSION=2.0.1

# ===== 容器名（同一台机器部署多套时改掉）=====
IGNIS_CONTAINER_NAME=ignis
MCP_CONTAINER_NAME=obsidian-mcp
